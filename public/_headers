# Response headers for Netlify and Cloudflare Pages (both read this file from the site root).
# The service worker and the page must revalidate so updates reach players; hashed assets never change.
/sw.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
